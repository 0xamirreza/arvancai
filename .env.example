# ArvanCloud Machine User API key (required for CDN/ECC/VOD/Live/Edge/CaaS/AI/metrics).
# Docs: https://docs.arvancloud.ir/en/accounts/iam/machine-user
ARVANCLOUD_API_KEY=

# Optional Object Storage S3 credentials (HMAC / Access+Secret).
# Required only for S3 tools. FA: HMAC keys are for Object Storage APIs.
# ARVANCLOUD_S3_ACCESS_KEY_ID=
# ARVANCLOUD_S3_SECRET_ACCESS_KEY=
# ARVANCLOUD_S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
# ARVANCLOUD_S3_REGION=default

# Optional base URL overrides (defaults match OpenAPI portal)
# ARVANCLOUD_CDN_BASE_URL=https://napi.arvancloud.ir/cdn/4.0
# ARVANCLOUD_ECC_BASE_URL=https://napi.arvancloud.ir/ecc/v1
# ARVANCLOUD_ECC_V3_BASE_URL_TEMPLATE=https://ecc.{region}.arvanapis.ir/v3
# ARVANCLOUD_VOD_BASE_URL=https://napi.arvancloud.ir/vod/2.0
# ARVANCLOUD_LIVE_BASE_URL=https://napi.arvancloud.ir/live/2.0
# ARVANCLOUD_VADS_BASE_URL=https://napi.arvancloud.ir/vads/2.0
# ARVANCLOUD_EDGE_BASE_URL=https://napi.arvancloud.ir/edge-computing/v1
# ARVANCLOUD_AIAAS_BASE_URL=https://napi.arvancloud.ir/ai/v1
# ARVANCLOUD_CAAS_ZONES_BASE_URL=https://napi.arvancloud.ir/caas/v2/zones
# ARVANCLOUD_STORAGE_API_BASE_URL=https://storage.arvanapis.ir/v1
# ARVANCLOUD_LOGGING_BASE_URL=https://napi.arvancloud.ir/logging/v1

# ARVANCLOUD_TIMEOUT_MS=30000
# ARVANCLOUD_LOG_LEVEL=info
